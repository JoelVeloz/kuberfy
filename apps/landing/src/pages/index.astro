---
import Layout from "@/layouts/Layout.astro";
import HomeContent from "@/components/HomeContent.astro";
---

<Layout lang="en">
  <HomeContent lang="en" />
</Layout>

<script>
  // Static site — no server to inspect Accept-Language, so detection happens once, client-side, on the default
  // (English) entry point only. A flag in localStorage means it only ever redirects a visitor's first load; picking
  // a language manually via the switcher (or just staying on this page) is never overridden afterward.
  const KEY = "kuberfy-lang-choice";
  if (!localStorage.getItem(KEY)) {
    localStorage.setItem(KEY, "auto");
    const lang = navigator.language.toLowerCase();
    if (lang.startsWith("pt")) {
      window.location.replace("/pt-br/");
    } else if (lang.startsWith("es")) {
      window.location.replace("/es/");
    }
  }
</script>
