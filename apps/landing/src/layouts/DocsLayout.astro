---
import Layout from "./Layout.astro";
import DocsHeader from "../components/DocsHeader.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Documentation — Kuberfy", description = "Learn how to install, configure, and manage applications with Kuberfy." } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<Layout title={title} description={description}>
  <div class="min-h-screen flex flex-col bg-ink text-cream">
    <DocsHeader currentPath={currentPath} />

    <div class="mx-auto flex w-full max-w-7xl flex-1 px-4 md:px-8">
      <DocsSidebar currentPath={currentPath} />

      <main class="min-w-0 flex-1 py-8 md:px-12 md:py-12">
        <article class="prose-kuberfy max-w-3xl">
          <slot />
        </article>
      </main>
    </div>
  </div>
</Layout>

<style is:global>
  /* Custom documentation styling matching Kuberfy's design system */
  .prose-kuberfy h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    margin-bottom: 1.5rem;
  }

  .prose-kuberfy h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .prose-kuberfy h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-cream);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-kuberfy p {
    color: var(--color-smoke);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .prose-kuberfy ul,
  .prose-kuberfy ol {
    color: var(--color-smoke);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose-kuberfy ul {
    list-style-type: disc;
  }

  .prose-kuberfy ol {
    list-style-type: decimal;
  }

  .prose-kuberfy li {
    margin-bottom: 0.5rem;
  }

  .prose-kuberfy li strong {
    color: var(--color-cream);
  }

  .prose-kuberfy strong {
    color: var(--color-cream);
    font-weight: 600;
  }

  .prose-kuberfy a {
    color: var(--color-ember);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .prose-kuberfy a:hover {
    color: var(--color-ember-bright);
  }

  .prose-kuberfy pre {
    background-color: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    overflow-x: auto;
    font-family: var(--font-display);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-cream);
  }

  .prose-kuberfy code:not(pre code) {
    background-color: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    padding: 0.15rem 0.35rem;
    font-family: var(--font-display);
    font-size: 0.85em;
    color: var(--color-cream);
  }

  .prose-kuberfy img {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.5);
    margin: 1.5rem 0;
  }

  .prose-kuberfy figure {
    margin: 1.5rem 0;
  }

  .prose-kuberfy figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-smoke);
    text-align: center;
  }

  .prose-kuberfy table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .prose-kuberfy th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-panel);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .prose-kuberfy td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-smoke);
  }

  .prose-kuberfy tr:hover td {
    background-color: var(--color-panel-2);
  }

  .callout-info {
    border-left: 3px solid var(--color-ember);
    background-color: var(--color-panel);
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    border-radius: 0.375rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .callout-tip {
    border-left: 3px solid var(--color-signal);
    background-color: var(--color-panel);
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    border-radius: 0.375rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
</style>
