<!-- Copy & Interactive Tabs Scripts -->
<script>
  function setupInteractions() {
    // Copy button handler for hero and quickstart
    const copyButtons = document.querySelectorAll("button[data-target]");
    copyButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const codeEl = document.getElementById(targetId);
        const text = codeEl?.textContent?.replace(/^\s*\$\s*/, "").trim() ?? "";
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          const copied = btn.getAttribute("data-copied") || "Copied!";
          btn.textContent = copied;
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch (e) {
          console.error("Clipboard copy failed", e);
        }
      });
    });

    // Quickstart Tabs
    const tabs = document.querySelectorAll(".cmd-tab");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabName = tab.getAttribute("data-tab");
        if (!tabName) return;

        // Reset tab styles
        tabs.forEach((t) => {
          t.classList.remove("border-ember", "text-cream");
          t.classList.add("border-transparent", "text-smoke-dim");
        });

        // Activate clicked tab
        tab.classList.remove("border-transparent", "text-smoke-dim");
        tab.classList.add("border-ember", "text-cream");

        // Hide all panels
        document.querySelectorAll(".tab-panel").forEach((panel) => {
          panel.classList.add("hidden");
          panel.classList.remove("flex");
        });

        // Show active panel
        const activePanel = document.getElementById(`tab-content-${tabName}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
          activePanel.classList.add("flex");
        }
      });
    });
  }

  // Run on initial page load and after client navigation
  setupInteractions();
  document.addEventListener("astro:page-load", setupInteractions);
</script>
