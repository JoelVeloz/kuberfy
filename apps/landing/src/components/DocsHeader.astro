---
import KuberfyMark from "@/components/KuberfyMark.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/docs" } = Astro.props;
---

<header class="sticky top-0 z-40 flex h-16 w-full items-center justify-between border-b border-line bg-ink/90 px-4 backdrop-blur md:px-8">
  <div class="flex items-center gap-4">
    <!-- Mobile sidebar toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle sidebar navigation"
      class="flex h-9 w-9 items-center justify-center rounded-md border border-line bg-panel text-smoke transition-colors hover:text-cream md:hidden cursor-pointer"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <a href="/" class="flex items-center gap-2 font-display text-base font-semibold tracking-tight text-cream">
      <KuberfyMark class="size-5" />
      <span>
        kuberfy<span class="text-ember">.</span>
      </span>
      <span class="rounded bg-panel px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-smoke border border-line">Docs</span>
    </a>
  </div>

  <nav class="flex items-center gap-4 text-sm">
    <a href="/" class="hidden text-smoke transition-colors hover:text-cream sm:inline">
      Home
    </a>
    <a href="/docs" class="text-ember font-medium">
      Documentation
    </a>
    <a
      href="https://github.com/JoelVeloz/kuberfy"
      target="_blank"
      rel="noreferrer"
      class="flex items-center gap-1.5 rounded-md border border-line bg-panel px-3 py-1.5 text-xs text-cream transition-colors hover:border-ember hover:text-ember"
    >
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
        />
      </svg>
      <span>GitHub</span>
    </a>
  </nav>
</header>
