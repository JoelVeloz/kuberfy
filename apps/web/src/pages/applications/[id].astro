---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { DeploymentsPanel } from "@/components/DeploymentsPanel";
import { applications, getProjectById, getDeploymentsByApplication, getDomainsByApplication } from "@/lib/mock-data";

export function getStaticPaths() {
  return applications.map((application) => ({
    params: { id: application.id },
    props: { application },
  }));
}

const { application } = Astro.props;
const project = getProjectById(application.projectId);
const projectDeployments = getDeploymentsByApplication(application.id);
const applicationDomains = getDomainsByApplication(application.id);
const envVarEntries = Object.entries(application.envVars);
---

<Layout
  title={application.name}
  back={{
    href: `/projects/${application.projectId}`,
    label: project?.name ?? "Project",
  }}
>
  <div class="flex flex-wrap items-baseline gap-3">
    <h1 class="font-heading text-lg font-medium">{application.name}</h1>
    <Badge variant="outline">{application.buildType}</Badge>
  </div>
  <p class="mt-1 text-xs text-muted-foreground">
    {application.repoUrl}
    <span class="text-border">·</span>
    <span class="font-mono">{application.branch}</span>
  </p>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="font-heading text-sm font-medium">Deployments</h2>
      <p class="mt-1 text-xs text-muted-foreground">Build and release history for this application.</p>
      <Card className="mt-3">
        <CardContent className="px-4">
          <DeploymentsPanel deployments={projectDeployments} client:load />
        </CardContent>
      </Card>

      <h2 class="mt-8 font-heading text-sm font-medium">Live logs</h2>
      <p class="mt-1 text-xs text-muted-foreground">Streamed output from the current build or running container.</p>
      <div class="mt-3 flex h-40 items-center justify-center border border-dashed border-border bg-muted/30">
        <p class="text-xs text-muted-foreground">Live log streaming is not available yet.</p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div>
        <h2 class="font-heading text-sm font-medium">Domains</h2>
        <Card className="mt-3">
          <CardContent>
            {applicationDomains.length === 0 ? (
              <p class="text-xs text-muted-foreground">No custom domains configured.</p>
            ) : (
              <ul class="flex flex-col gap-2">
                {applicationDomains.map((domain) => (
                  <li class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono">{domain.host}</span>
                    <Badge variant="outline">SSL</Badge>
                  </li>
                ))}
              </ul>
            )}
          </CardContent>
        </Card>
      </div>

      <div>
        <h2 class="font-heading text-sm font-medium">Environment variables</h2>
        <Card className="mt-3">
          <CardContent>
            {envVarEntries.length === 0 ? (
              <p class="text-xs text-muted-foreground">No environment variables configured.</p>
            ) : (
              <ul class="flex flex-col gap-2">
                {envVarEntries.map(([key]) => (
                  <li class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-mono">{key}</span>
                    <span class="font-mono text-muted-foreground">••••••••</span>
                  </li>
                ))}
              </ul>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>
