---
import Layout from "@/layouts/Layout.astro";
import { ApplicationDetail } from "@/components/ApplicationDetail";

// Static output needs at least one path; the real id is read from the URL client-side (see PLAN.md "SPA fallback")
export function getStaticPaths() {
  return [{ params: { id: "_" } }];
}
---

<Layout title="Application">
  <ApplicationDetail client:load />
</Layout>
