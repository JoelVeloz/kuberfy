---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { KuberfyMark } from "@/components/KuberfyMark";
import { LoginForm } from "@/components/LoginForm";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored === "dark" || (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Sign in · Kuberfy</title>
    <ClientRouter />
  </head>
  <body>
    <div class="grid min-h-screen bg-background lg:grid-cols-2">
      <div class="flex items-center justify-center px-6 py-16">
        <LoginForm client:load />
      </div>
      <div
        class="relative hidden overflow-hidden border-l border-border bg-foreground lg:flex lg:flex-col lg:justify-between lg:p-10"
        style="background-image: linear-gradient(color-mix(in srgb, var(--color-background) 8%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-background) 8%, transparent) 1px, transparent 1px); background-size: 32px 32px;"
      >
        <span class="flex items-center gap-2 font-heading text-sm font-medium tracking-tight text-background">
          <KuberfyMark className="size-4" />
          Kuberfy
        </span>
        <p class="max-w-xs font-heading text-2xl leading-snug text-background">Deploy applications on your own infrastructure, without the overhead.</p>
      </div>
    </div>
  </body>
</html>
