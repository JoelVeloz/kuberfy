---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { LoginForm } from "@/components/LoginForm";
import { DeployPreview } from "@/components/DeployPreview";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Sign in · Kuberfy</title>
    <ClientRouter />
  </head>
  <body>
    <div class="flex items-center gap-2 border-b border-border px-6 py-4 lg:hidden">
      <span class="font-heading text-sm font-medium tracking-tight">Kuberfy</span>
    </div>
    <div class="grid min-h-screen lg:grid-cols-2">
      <div class="flex items-center justify-center px-6 py-16">
        <LoginForm client:load />
      </div>
      <div class="relative hidden flex-col justify-between overflow-hidden border-l border-border bg-foreground p-10 lg:flex">
        <span class="font-heading text-sm font-medium tracking-tight text-background">Kuberfy</span>

        <div class="flex max-w-md flex-col gap-8">
          <p class="font-heading text-3xl leading-tight tracking-tight text-background">
            Deploy your apps on your own server, without the overhead.
          </p>

          <DeployPreview client:visible />

          <div class="flex flex-col gap-2 font-mono text-xs text-neutral-500">
            <p>Deploys roll out with zero downtime on Docker Swarm.</p>
            <p>The database is embedded, so there's nothing extra to run.</p>
            <p>SSL certificates renew on their own through Traefik.</p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

