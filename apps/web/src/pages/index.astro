---
import Layout from "@/layouts/Layout.astro";
import { NewProjectDialog } from "@/components/NewProjectDialog";
import { ProjectsTable } from "@/components/ProjectsTable";
---

<Layout title="Projects">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="font-heading text-lg font-medium">Projects</h1>
      <p class="mt-1 text-xs text-muted-foreground">Applications on this server are grouped into projects.</p>
    </div>
    <NewProjectDialog client:load />
  </div>

  <ProjectsTable client:load />
</Layout>
