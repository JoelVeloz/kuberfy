---
import Layout from "@/layouts/Layout.astro";
import { SystemTabs } from "@/components/SystemTabs";
import { PruneDockerButton } from "@/components/PruneDockerButton";
---

<Layout title="System">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="font-heading text-lg font-medium">System</h1>
      <p class="mt-1 text-xs text-muted-foreground">Host resource usage and per-app footprint.</p>
    </div>
    <PruneDockerButton client:load />
  </div>
  <div class="mt-6">
    <SystemTabs client:load />
  </div>
</Layout>
