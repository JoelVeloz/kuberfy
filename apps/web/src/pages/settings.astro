---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { SettingsForm } from "@/components/SettingsForm";
import { ExposedPortsCard } from "@/components/ExposedPortsCard";
import { PasskeyCard } from "@/components/PasskeyCard";
import { UpdateCard } from "@/components/UpdateCard";
---

<Layout title="Settings">
  <h1 class="font-heading text-lg font-medium">Settings</h1>
  <p class="mt-1 text-xs text-muted-foreground">Instance-level configuration for this kuberfy server.</p>

  <div class="mt-6 flex max-w-2xl flex-col gap-6">
    <SettingsForm client:load />
    <UpdateCard client:load />
    <PasskeyCard client:load />
    <ExposedPortsCard client:load />
    <Card>
      <CardContent className="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-medium">MCP</h2>
          <p class="mt-1 text-xs text-muted-foreground">Let an AI agent create and deploy projects on this instance.</p>
        </div>
        <a href="/mcp" class={buttonVariants({ size: "sm", variant: "outline" })}>
          Set up
        </a>
      </CardContent>
    </Card>
  </div>
</Layout>
