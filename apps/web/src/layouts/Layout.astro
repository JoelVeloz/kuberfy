---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SidebarIcon } from "@phosphor-icons/react";
import { AppShell, SIDEBAR_TOGGLE_ATTRIBUTE } from "@/components/AppShell";
import { Button } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title: string;
  back?: { href: string; label: string };
}

const { title, back } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        function applyTheme() {
          var stored = localStorage.getItem("theme");
          var dark = stored === "dark" || (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        }
        applyTheme();
        // Astro's view transitions swap in a freshly server-rendered <html> (no "dark" class baked in) on every
        // soft navigation, and this inline script itself doesn't re-run then — without this, the theme visibly
        // resets to light on the very next page after any client-side navigation.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Kuberfy</title>
    <script is:inline>
      document.startViewTransition = undefined;
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div data-slot="sidebar-wrapper" class="group/sidebar-wrapper flex min-h-svh w-full">
      <AppShell client:load transition:persist="app-sidebar" pathname={Astro.url.pathname} defaultOpen={true} />
      <main data-slot="sidebar-inset" class="relative flex w-full flex-1 flex-col bg-background">
        <header class="flex h-12 shrink-0 items-center gap-2 border-b border-border px-4">
          <Button variant="ghost" size="icon-sm" className="-ml-1" {...{ [SIDEBAR_TOGGLE_ATTRIBUTE]: "" }}>
            <SidebarIcon />
            <span class="sr-only">Toggle Sidebar</span>
          </Button>
          {
            back && (
              <>
                <Separator orientation="vertical" className="h-4" />
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                  <a href={back.href} class="transition-colors hover:text-foreground">
                    {back.label}
                  </a>
                  <span class="text-border">/</span>
                  <span class="text-foreground">{title}</span>
                </div>
              </>
            )
          }
        </header>
        <div class="flex-1 px-4 py-8 md:px-8">
          <slot />
        </div>
      </main>
    </div>
    <Toaster client:load transition:persist="toaster" position="bottom-right" />
    <script>
      import "@/lib/prefetch";
    </script>
  </body>
</html>
