---
import "@/styles/global.css";
import { UserMenu } from "@/components/UserMenu";

interface Props {
  title: string;
  back?: { href: string; label: string };
}

const { title, back } = Astro.props;
const isProjectsActive = Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/projects");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Kuberfy</title>
  </head>
  <body>
    <div class="min-h-screen bg-background md:flex">
      <aside class="flex items-center justify-between gap-3 border-b border-border px-4 py-3 md:fixed md:inset-y-0 md:left-0 md:w-60 md:flex-col md:items-stretch md:justify-start md:gap-0 md:border-r md:border-b-0 md:px-0 md:py-0">
        <a href="/" class="font-heading text-sm font-medium tracking-tight md:border-b md:border-border md:px-4 md:py-4">
          Kuberfy
        </a>
        <nav class="flex items-center gap-1 md:flex-1 md:flex-col md:items-stretch md:gap-0.5 md:px-2 md:py-4">
          <a
            href="/"
            class={`px-3 py-1.5 text-xs font-medium transition-colors ${
              isProjectsActive ? "bg-accent text-accent-foreground" : "text-muted-foreground hover:bg-accent/50 hover:text-foreground"
            }`}
          >
            Projects
          </a>
        </nav>
        <div class="md:border-t md:border-border md:p-3">
          <UserMenu client:load />
        </div>
      </aside>
      <main class="flex-1 px-4 py-8 md:ml-60 md:px-8">
        {back && (
          <div class="mb-6 flex items-center gap-2 text-xs text-muted-foreground">
            <a href={back.href} class="transition-colors hover:text-foreground">
              {back.label}
            </a>
            <span class="text-border">/</span>
            <span class="text-foreground">{title}</span>
          </div>
        )}
        <slot />
      </main>
    </div>
  </body>
</html>
