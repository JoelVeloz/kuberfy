---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { AppShell } from "@/components/AppShell";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title: string;
  back?: { href: string; label: string };
}

const { title, back } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        function applyTheme() {
          var stored = localStorage.getItem("theme");
          var dark = stored === "dark" || (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        }
        applyTheme();
        // Astro's view transitions swap in a freshly server-rendered <html> (no "dark" class baked in) on every
        // soft navigation, and this inline script itself doesn't re-run then — without this, the theme visibly
        // resets to light on the very next page after any client-side navigation.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Kuberfy</title>
    <ClientRouter />
  </head>
  <body>
    <AppShell client:load pathname={Astro.url.pathname} defaultOpen={true} title={title} back={back}>
      <slot />
    </AppShell>
    <Toaster client:load position="bottom-right" />
  </body>
</html>
