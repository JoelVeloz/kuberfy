DATABASE_PATH=kuberfy.db
BETTER_AUTH_SECRET=
# optional — seeds the settings table on first boot only; change the domain from the Settings page after that
KUBERFY_DOMAIN=localhost
# optional — extra origins the API must accept cross-origin (CORS + Better Auth trust) beyond the current
# kuberfyDomain — e.g. the dev "web" panel's own port, since it and this API are separate origins in dev
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# optional — set by install.sh in production; when absent, new applications get a `.localhost` domain instead of sslip.io
SERVER_PUBLIC_IP=
